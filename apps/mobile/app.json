{
  "expo": {
    "name": "DOGO",
    "slug": "dogo",
    "scheme": "dogo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router"],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "../../assets/brand/dogo-logo.png"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dogo.app"
    },
    "icon": "../../assets/brand/dogo-logo.png"
  }
}
